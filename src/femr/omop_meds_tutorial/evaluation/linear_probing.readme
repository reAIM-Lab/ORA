### Tutorial for Linear Probing

1. Commands for running run_motor_cbs.sh

bash run_motor.sh  \
  --pretraining_data   /user/zj2398/cache/motor_mimic_8k \       # general dir where tokenizer/task.pkl 
  --meds_reader        /shared/share_mala/zj2398/mimic/meds_v0.6_reader \ # path to mimic meds_reader
  --num_proc           100 \      
  --model_path         /user/zj2398/cache/motor_mimic_8k/output/best_100620 \   # pretrained_model_path
  --model_name         motor \
  --tokens_per_batch   65536 \
  --device             cuda:0 \
  --min_subjects_per_batch 8 \
  --ontology_path       /user/zj2398/cache/motor_mimic_8k/ontology.pkl \        # ontology path for 
  --main_split_path     /user/zj2398/cache/motor_mimic_8k/main_split.csv \
  --output_dir   $Output_Dir \
  /shared/share_mala/zj2398/mimic/phenotype_task/cohort/    # path to phenotype_cohort